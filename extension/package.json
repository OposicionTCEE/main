{
  "name": "tcee-panel",
  "displayName": "Panel TCEE",
  "description": "Panel de trabajo para los temas de la oposición TCEE: acciones, tiempo restante, índice, calendario, relaciones y cante.",
  "version": "0.56.0",
  "publisher": "oposiciontcee",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/OposicionTCEE/main"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "configuration": {
      "title": "Panel TCEE",
      "properties": {
        "tcee.accionesOcultas": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "compilar",
              "revisar",
              "sincronizar",
              "nota",
              "panelOposicion",
              "atajos",
              "notasClaude",
              "rehacerInformes"
            ]
          },
          "description": "Acciones de la barra lateral TCEE que no se ven (se cambian en la acción Ajustes; main/AJUSTES.md). «Ajustes» siempre se ve."
        },
        "tcee.indiceVisible": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar la vista Índice del tema en la barra lateral TCEE (debajo de Acciones)."
        },
        "tcee.botonAtajos": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar el botón «Atajos» en la barra inferior mientras se edita un .tex."
        },
        "tcee.claudeAbrirEn": {
          "type": "string",
          "default": "barraLateral",
          "enum": [
            "barraLateral",
            "pestana",
            "ventanaNueva"
          ],
          "enumItemLabels": [
            "En la barra lateral",
            "En una pestaña",
            "En una ventana aparte"
          ],
          "enumDescriptions": [
            "A la derecha, junto al panel TCEE (como hasta ahora).",
            "En una pestaña nueva del editor, junto a tus temas.",
            "En tu ventana de Claude si ya hay una abierta; si no, en una ventana nueva."
          ],
          "description": "Dónde se abre Claude Code con el encargo ya escrito (Notas del tema con Claude y Rehacer informes; main/AJUSTES.md)."
        },
        "tcee.revisarSentido": {
          "type": "string",
          "default": "pdf",
          "enum": [
            "pdf",
            "ambos",
            "no"
          ],
          "enumItemLabels": [
            "El PDF manda",
            "En los dos sentidos",
            "Sin sincronizar"
          ],
          "enumDescriptions": [
            "Al moverte por el PDF, el texto lo sigue; el texto se mueve libre.",
            "El que muevas manda: el otro lo sigue.",
            "Se mueven por separado; el doble clic en el PDF sigue llevando el cursor al texto."
          ],
          "description": "Revisar: quién manda al desplazarse (main/REVISAR.md). También se cambia con el botón del visor."
        },
        "tcee.revisarSeguimiento": {
          "type": "string",
          "default": "alParar",
          "enum": [
            "alParar",
            "alCambiar",
            "continuo"
          ],
          "enumItemLabels": [
            "Al parar",
            "Al cambiar de lado",
            "Continuo"
          ],
          "enumDescriptions": [
            "El otro lado no se mueve mientras te desplazas: va a su sitio cuando paras medio segundo.",
            "El otro lado se queda quieto hasta que pasas el ratón a él.",
            "El otro lado se mueve a la vez que el que mueves."
          ],
          "description": "Revisar: cuándo se mueve el lado que sigue al otro (main/REVISAR.md). También con el botón «Sigue» del visor."
        },
        "tcee.revisarAtenuar": {
          "type": "boolean",
          "default": true,
          "description": "Revisar: oscurecer el lado donde no está el ratón (en el texto, menos el párrafo de la banda). También con el botón ◐ del visor."
        },
        "tcee.revisarOscuridad": {
          "type": "number",
          "default": 70,
          "enum": [
            40,
            55,
            70,
            85
          ],
          "enumItemLabels": [
            "Poco (40 %)",
            "Medio (55 %)",
            "Bastante (70 %)",
            "Mucho (85 %)"
          ],
          "enumDescriptions": [
            "Se sigue leyendo bien el lado oscurecido.",
            "Como en la versión 0.55.",
            "Por defecto: el lado sin ratón queda en segundo plano.",
            "Casi no se ve: solo el lado donde está el ratón."
          ],
          "description": "Revisar: cuánto se oscurece el lado donde no está el ratón (si «Oscurecer» está encendido)."
        },
        "tcee.revisarSuave": {
          "type": "boolean",
          "default": true,
          "description": "Revisar: deslizarse en vez de saltar. Para el texto activa el desplazamiento suave de VS Code en los .tex (editor.smoothScrolling, en TCEE.code-workspace); al apagarlo se quita."
        },
        "tcee.revisarBanda": {
          "type": "boolean",
          "default": true,
          "description": "Revisar: resaltar en el texto el párrafo que corresponde al punto de lectura del PDF."
        },
        "tcee.notasContraidasAlAbrir": {
          "type": "boolean",
          "default": true,
          "description": "Al abrir un tema, contraer las notas al pie (\\footnote) escritas en varias líneas."
        },
        "tcee.preambuloContraidoAlAbrir": {
          "type": "boolean",
          "default": true,
          "description": "Al abrir un tema, plegar el preámbulo: desde la línea siguiente a \\documentclass hasta «% --- Datos del tema ---» (main/NOTAS.md)."
        },
        "tcee.fusionAlGuardar": {
          "type": "boolean",
          "default": true,
          "description": "Fusión al guardar: si Claude cambia un tema (.tex) mientras escribes, sus cambios y los tuyos se combinan al guardar (main/EDICION_SIMULTANEA.md). Al apagarla, VS Code vuelve a preguntar «Comparar / Sobrescribir». Registro en Salida › Panel TCEE: fusión."
        }
      }
    },
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "tceePanel",
          "title": "TCEE",
          "icon": "media/tcee.svg"
        }
      ]
    },
    "views": {
      "tceePanel": [
        {
          "id": "tcee.acciones",
          "name": "Acciones",
          "initialSize": 1
        },
        {
          "id": "tcee.indice",
          "name": "Índice",
          "initialSize": 2,
          "when": "config.tcee.indiceVisible"
        }
      ]
    },
    "commands": [
      {
        "command": "tcee.compilar",
        "title": "Compilar tema",
        "category": "TCEE",
        "icon": "$(play)"
      },
      {
        "command": "tcee.revisar",
        "title": "Revisar el tema y su PDF (lado a lado, sincronizados)",
        "category": "TCEE",
        "icon": "$(open-preview)"
      },
      {
        "command": "tcee.sincronizar",
        "title": "Sincronizar con GitHub",
        "category": "TCEE",
        "icon": "$(sync)"
      },
      {
        "command": "tcee.fijar",
        "title": "Fijar este índice",
        "category": "TCEE",
        "icon": "$(pin)"
      },
      {
        "command": "tcee.soltar",
        "title": "Soltar el índice (seguir al cursor)",
        "category": "TCEE",
        "icon": "$(pinned)"
      },
      {
        "command": "tcee.refrescar",
        "title": "Actualizar índice",
        "category": "TCEE",
        "icon": "$(refresh)"
      },
      {
        "command": "tcee.irA",
        "title": "Ir al epígrafe",
        "category": "TCEE"
      },
      {
        "command": "tcee.hecho",
        "title": "Marcar el tema como hecho",
        "category": "TCEE",
        "icon": "$(check)"
      },
      {
        "command": "tcee.noHecho",
        "title": "Hecho ✓ (pulsa para desmarcar)",
        "category": "TCEE",
        "icon": "$(pass-filled)"
      },
      {
        "command": "tcee.detalleTiempo",
        "title": "Ver de dónde sale el tiempo restante",
        "category": "TCEE",
        "icon": "$(info)"
      },
      {
        "command": "tcee.notasClaude",
        "title": "Notas del tema con Claude",
        "category": "TCEE",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "tcee.rehacerInformes",
        "title": "Rehacer informes de armonización",
        "category": "TCEE",
        "icon": "$(beaker)"
      },
      {
        "command": "tcee.nota",
        "title": "Nueva nota",
        "category": "TCEE",
        "icon": "$(note)"
      },
      {
        "command": "tcee.panelOposicion",
        "title": "Panel Oposición",
        "category": "TCEE",
        "icon": "$(dashboard)"
      },
      {
        "command": "tcee.negrita",
        "title": "Negrita (\\textbf)",
        "category": "TCEE"
      },
      {
        "command": "tcee.cursiva",
        "title": "Cursiva (\\textit)",
        "category": "TCEE"
      },
      {
        "command": "tcee.vistaFormulas",
        "title": "Vista previa de la fórmula (sigue al cursor)",
        "category": "TCEE"
      },
      {
        "command": "tcee.notasAlternar",
        "title": "Contraer o expandir las notas al pie",
        "category": "TCEE"
      },
      {
        "command": "tcee.notasContraer",
        "title": "Contraer las notas al pie",
        "category": "TCEE"
      },
      {
        "command": "tcee.notasExpandir",
        "title": "Expandir las notas al pie",
        "category": "TCEE"
      },
      {
        "command": "tcee.nuevaNota",
        "title": "Insertar nota al pie (contraíble)",
        "category": "TCEE"
      },
      {
        "command": "tcee.mayusculas",
        "title": "Poner en mayúsculas (sin tocar órdenes ni fórmulas)",
        "category": "TCEE"
      },
      {
        "command": "tcee.resaltar",
        "title": "Resaltar en amarillo (\\hl)",
        "category": "TCEE"
      },
      {
        "command": "tcee.dolar",
        "title": "Escribir $ (fórmula en línea)",
        "category": "TCEE"
      },
      {
        "command": "tcee.colorear",
        "title": "Rodear de color (\\textcolor) la selección",
        "category": "TCEE"
      },
      {
        "command": "tcee.intro",
        "title": "Intro en una lista (añade \\item)",
        "category": "TCEE"
      },
      {
        "command": "tcee.atajos",
        "title": "Ver los atajos del Panel TCEE",
        "category": "TCEE"
      },
      {
        "command": "tcee.ajustes",
        "title": "Ajustes del Panel TCEE",
        "category": "TCEE",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tcee.fijar",
          "when": "view == tcee.indice && !tcee.fijado",
          "group": "navigation@1"
        },
        {
          "command": "tcee.soltar",
          "when": "view == tcee.indice && tcee.fijado",
          "group": "navigation@1"
        },
        {
          "command": "tcee.refrescar",
          "when": "view == tcee.indice",
          "group": "navigation@2"
        },
        {
          "command": "tcee.hecho",
          "when": "view == tcee.acciones && tcee.hayTema && !tcee.hecho",
          "group": "navigation@1"
        },
        {
          "command": "tcee.noHecho",
          "when": "view == tcee.acciones && tcee.hayTema && tcee.hecho",
          "group": "navigation@1"
        },
        {
          "command": "tcee.detalleTiempo",
          "when": "view == tcee.acciones && tcee.hayTema",
          "group": "detalle@1"
        },
        {
          "command": "tcee.ajustes",
          "when": "view == tcee.acciones",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "tcee.irA",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tcee.negrita",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "when": "editorTextFocus && !editorReadonly && editorLangId == latex"
      },
      {
        "command": "tcee.cursiva",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "when": "editorTextFocus && !editorReadonly && editorLangId == latex"
      },
      {
        "command": "tcee.vistaFormulas",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && editorLangId == latex"
      },
      {
        "command": "tcee.notasAlternar",
        "key": "ctrl+alt+shift+n",
        "mac": "cmd+alt+n",
        "when": "editorTextFocus && editorLangId == latex"
      },
      {
        "command": "tcee.nuevaNota",
        "key": "ctrl+alt+shift+f",
        "mac": "cmd+alt+shift+n",
        "when": "editorTextFocus && !editorReadonly && editorLangId == latex"
      },
      {
        "command": "tcee.mayusculas",
        "key": "ctrl+alt+u",
        "mac": "cmd+alt+u",
        "when": "editorTextFocus && !editorReadonly && editorLangId == latex"
      },
      {
        "command": "tcee.resaltar",
        "key": "ctrl+alt+h",
        "mac": "ctrl+h",
        "when": "editorTextFocus && !editorReadonly && editorLangId == latex"
      },
      {
        "command": "tcee.dolar",
        "key": "shift+4",
        "when": "editorTextFocus && !editorReadonly && editorLangId == latex"
      },
      {
        "command": "tcee.intro",
        "key": "enter",
        "when": "editorTextFocus && !editorReadonly && editorLangId == latex && tcee.enLista && !suggestWidgetVisible && !inSnippetMode && !editorHasMultipleSelections"
      },
      {
        "command": "tcee.atajos",
        "key": "ctrl+alt+shift+a",
        "mac": "cmd+alt+k"
      },
      {
        "command": "tcee.colorear",
        "key": "ctrl+alt+c",
        "mac": "ctrl+c",
        "when": "editorTextFocus && !editorReadonly && editorLangId == latex"
      },
      {
        "command": "tcee.revisar",
        "key": "ctrl+alt+e",
        "mac": "cmd+alt+e",
        "when": "editorLangId == latex"
      }
    ]
  }
}
