{
  "name": "tcee-panel",
  "displayName": "Panel TCEE",
  "description": "Panel de trabajo para los temas de la oposición TCEE: acciones, tiempo restante e índice del tema.",
  "version": "0.7.0",
  "publisher": "oposiciontcee",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/OposicionTCEE/main"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "tceePanel",
          "title": "TCEE",
          "icon": "media/tcee.svg"
        }
      ]
    },
    "views": {
      "tceePanel": [
        {
          "id": "tcee.acciones",
          "name": "Acciones",
          "initialSize": 1
        },
        {
          "id": "tcee.indice",
          "name": "Índice",
          "initialSize": 2
        }
      ]
    },
    "commands": [
      {
        "command": "tcee.compilar",
        "title": "Compilar tema",
        "category": "TCEE",
        "icon": "$(play)"
      },
      {
        "command": "tcee.sincronizar",
        "title": "Sincronizar con GitHub",
        "category": "TCEE",
        "icon": "$(sync)"
      },
      {
        "command": "tcee.fijar",
        "title": "Fijar este índice",
        "category": "TCEE",
        "icon": "$(pin)"
      },
      {
        "command": "tcee.soltar",
        "title": "Soltar el índice (seguir al cursor)",
        "category": "TCEE",
        "icon": "$(pinned)"
      },
      {
        "command": "tcee.refrescar",
        "title": "Actualizar índice",
        "category": "TCEE",
        "icon": "$(refresh)"
      },
      {
        "command": "tcee.irA",
        "title": "Ir al epígrafe",
        "category": "TCEE"
      },
      {
        "command": "tcee.hecho",
        "title": "Marcar el tema como hecho",
        "category": "TCEE",
        "icon": "$(check)"
      },
      {
        "command": "tcee.noHecho",
        "title": "Hecho ✓ (pulsa para desmarcar)",
        "category": "TCEE",
        "icon": "$(pass-filled)"
      },
      {
        "command": "tcee.detalleTiempo",
        "title": "Ver de dónde sale el tiempo restante",
        "category": "TCEE",
        "icon": "$(info)"
      },
      {
        "command": "tcee.nota",
        "title": "Nueva nota",
        "category": "TCEE",
        "icon": "$(note)"
      },
      {
        "command": "tcee.panelOposicion",
        "title": "Panel Oposición",
        "category": "TCEE",
        "icon": "$(dashboard)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tcee.fijar",
          "when": "view == tcee.indice && !tcee.fijado",
          "group": "navigation@1"
        },
        {
          "command": "tcee.soltar",
          "when": "view == tcee.indice && tcee.fijado",
          "group": "navigation@1"
        },
        {
          "command": "tcee.refrescar",
          "when": "view == tcee.indice",
          "group": "navigation@2"
        },
        {
          "command": "tcee.hecho",
          "when": "view == tcee.acciones && tcee.hayTema && !tcee.hecho",
          "group": "navigation@1"
        },
        {
          "command": "tcee.noHecho",
          "when": "view == tcee.acciones && tcee.hayTema && tcee.hecho",
          "group": "navigation@1"
        },
        {
          "command": "tcee.detalleTiempo",
          "when": "view == tcee.acciones && tcee.hayTema",
          "group": "detalle@1"
        }
      ],
      "commandPalette": [
        {
          "command": "tcee.irA",
          "when": "false"
        }
      ]
    }
  }
}
